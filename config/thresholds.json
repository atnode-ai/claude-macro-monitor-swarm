{
  "_doc": "Alert policy, applied by tools/alert_gate.py. A release alerts when (a) its report is tier 1, or (b) |actual - consensus| on any listed metric reaches the threshold. Units match the metric (pct points for *_pct and rates, thousands for *_k, index points otherwise). Market thresholds are basis points over 5 trading days unless noted.",
  "always_alert_tiers": [1],
  "surprise": {
    "cpi": {"core.chg_pct": 0.1, "headline.chg_pct": 0.2},
