    "pce": {"core.chg_pct": 0.1},
    "nfp": {"payrolls_k.diff": 75, "unemployment_rate.level": 0.2},
    "claims": {"initial.level": 25000},
    "jolts": {"openings_k.level": 500},
    "adp": {"private_payrolls_k.diff": 75},
    "gdp": {"real_gdp_saar.level": 0.7},
    "retail": {"headline.chg_pct": 0.5, "ex_auto.chg_pct": 0.5},
    "indpro": {"ip.chg_pct": 0.4},
    "durables": {"core_capex_orders.chg_pct": 1.0},
    "trade": {"balance_bn.level": 8},
    "ism_mfg": {"pmi": 1.5},
    "ism_services": {"pmi": 1.5},
    "starts": {"starts_k.level": 100, "permits_k.level": 100},
    "new_home": {"sales_k.level": 60},
    "existing_home": {"sales_m.level": 0.15},
    "umich": {"sentiment.level": 3},
    "conf_board": {"index": 4},
